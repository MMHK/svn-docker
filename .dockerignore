# build context 只保留 v3 建置真正需要的東西
# （Dockerfile.svn：conf/ + docker-entrypoint.sh；Dockerfile.admin：web/ + api/）

# 版本控制與本機設定
.git
.gitignore
.gitattributes
.env
.env.*
!.env.example

# 文件
*.md
NOTICE

# 測試與執行期資料（由 compose 掛載，不進映像）
test/
data/

# v2 PHP 遺留（已刪除；保留規則避免舊工作區意外打進 context）
app/
views/
translations/
composer.json
composer.lock
vendor/

# 依賴與快取：由 node:22-alpine / golang stage 重新取得
node_modules/
**/node_modules/
.yarn/
**/.yarn/
*.log

# 建置不需要的本機腳本
build.sh
docker-compose*.yml

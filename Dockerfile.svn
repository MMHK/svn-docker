# syntax=docker/dockerfile:1
# =============================================================================
# mmhk/svn:3.0 — Apache 2.4 + mod_dav_svn
#
# 只負責 SVN（`/svn`）與管理面的反向代理（`/svnadmin`）。
# 沒有 PHP、沒有 iF.SVNAdmin、沒有 Node、沒有 Go。
#
# 建置：
#   docker build -f Dockerfile.svn -t mmhk/svn:3.0-dev .
# =============================================================================
FROM debian:bookworm-slim

ARG DEBIAN_FRONTEND=noninteractive

# apt 的 postinst 會嘗試啟動 apache2；build 期不需要也不應該啟動
RUN printf '#!/bin/sh\nexit 101\n' > /usr/sbin/policy-rc.d \
 && chmod +x /usr/sbin/policy-rc.d

RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      apache2 \
      libapache2-mod-svn \
      subversion \
      curl \
      ca-certificates \
 && rm -rf /var/lib/apt/lists/* \
 && rm -f /usr/sbin/policy-rc.d

# dav_svn + Basic + AuthzSVNAccessFile（/svn）
# proxy / proxy_http：/svnadmin → svn-admin:8080
# remoteip：還原 nginx 之後的真實 client IP（計畫 §5.5.1）
# headers：安全標頭
RUN a2enmod dav dav_svn authz_core auth_basic authz_user \
            proxy proxy_http remoteip headers \
 && rm -f /etc/apache2/sites-enabled/*

COPY conf/svn.conf /etc/apache2/sites-enabled/000-default.conf
COPY docker-entrypoint.sh /usr/local/bin/docker-entrypoint.sh

RUN chmod 0755 /usr/local/bin/docker-entrypoint.sh \
 && mkdir -p /var/svnlocal

# Apache 以 root 啟動（綁 80），worker 帳號的 uid/gid 由 entrypoint 依
# PUID/PGID 調整（遠端 /var/svnlocal owner = 1000:1000）。
ENV SVN_ENTRY_USER=www-data

WORKDIR /var/www
EXPOSE 80

# Debian 沒有 apache2-foreground（那是官方 httpd 映像的腳本），改用 apache2ctl。
# apache2ctl 會 source /etc/apache2/envvars，並把 Apache 留在前景。
ENTRYPOINT ["/usr/local/bin/docker-entrypoint.sh"]
CMD ["/usr/sbin/apache2ctl", "-D", "FOREGROUND"]

{
  "name": "mmhk/svnadmin",
  "description": "Web UI to manage Subversion authorization and authentication files",
  "type": "project",
  "license": "GPL-2.0-or-later",
  "require": {
    "php": ">=8.2",
    "ext-json": "*",
    "ext-mbstring": "*",
    "ext-session": "*",
    "nikic/fast-route": "^1.3",
    "psr/container": "^2.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.0",
    "phpstan/phpstan": "^2.0"
  },
  "autoload": {
    "psr-4": {
      "SvnAdmin\\": "src/"
    },
    "classmap": [
      "src/Core/Exceptions.php"
    ],
    "files": [
      "src/Support/globals.php",
      "src/Config/IniFileFunctions.php",
      "src/Support/functions.php",
      "src/Legacy/compat.php"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "SvnAdmin\\Tests\\": "tests/"
    }
  },
  "config": {
    "sort-packages": true,
    "optimize-autoloader": true,
    "allow-plugins": false
  }
}

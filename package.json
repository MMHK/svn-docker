{
  "name": "svn-docker-assets",
  "private": true,
  "scripts": {
    "build": "yarn build:css && yarn build:js",
    "build:css": "tailwindcss -i ./assets/app.css -o ./app/public/assets/app.css --minify",
    "watch:css": "tailwindcss -i ./assets/app.css -o ./app/public/assets/app.css --watch",
    "build:js": "node build-assets.mjs"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.0.0",
    "tailwindcss": "^4.0.0"
  }
}
